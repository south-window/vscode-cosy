# SYNTAX TEST "source.fox" "core COSY syntax"
WRITE 6 'hello world' ;
# <~~~~~~~~------------- string.quoted.single.cosy
WRITE 6 'don''t stop' ;
# <~~~~~~~~~~~~-- constant.character.escape.cosy
IF I=J ; WRITE 6 I ; ENDIF ;
# <~~~~- keyword.operator.comparison.cosy
IF I#J ; WRITE 6 I ; ENDIF ;
# <~~~~- keyword.operator.comparison.cosy
IF I<=J ; WRITE 6 I ; ENDIF ;
# <~~~~-- keyword.operator.comparison.cosy
IF I>=J ; WRITE 6 I ; ENDIF ;
# <~~~~-- keyword.operator.comparison.cosy
A := .5 ;
# <~~~~~-- constant.numeric.float.cosy
B := 1. ;
# <~~~~~-- constant.numeric.float.cosy
C := 1E-3 ;
# <~~~~~---- constant.numeric.float.cosy
D := 0.5D+2 ;
# <~~~~~------ constant.numeric.float.cosy
{K/M0/CLIGHT^2}
# <--------------- comment.block.cosy
VARIABLE ETA1 NM2 {K/M0/CLIGHT^2} ;
IF I=J ; ELSEIF I<J ; ENDIF ;
# <~~~~~~~~~------ keyword.control.cosy
ELSE ;
# <---- variable.other.cosy - keyword.control.cosy
GUIIO -201 B ;
# <----- keyword.control.cosy
DEBUG ;
# <----- keyword.control.cosy
E := 2^3 ;
# <~~~~~~- keyword.operator.arithmetic.cosy
dl := 1.5 ;
# <-- variable.other.cosy - entity.name.function.cosy
DL 1.5 ;
# <-- entity.name.function.cosy
POLVAL 1 V N .5 R 1 ;
# <------ entity.name.function.cosy
# <~~~~~~~~~~~- variable.other.cosy - entity.name.class.cosy
variable shot 1 ;
# <-------- storage.type.cosy
# <~~~~~~~~~---- entity.name.function.cosy
# <~~~~~~~~~~~~~~- constant.numeric.integer.cosy
